parameters:
	stubFiles:
		- stubs/Option.stub
		- stubs/nullish.stub
		- stubs/NullishType.stub
		- stubs/optional.stub
		- stubs/OptionalType.stub
		- stubs/Type.stub
		- stubs/TypeInterface.stub

services:
	-
		class: Psl\PHPStan\Type\TypeShapeReturnTypeExtension
		tags:
			- phpstan.broker.dynamicFunctionReturnTypeExtension

	-
		class: Psl\PHPStan\Type\TypeUnionReturnTypeExtension
		tags:
			- phpstan.broker.dynamicFunctionReturnTypeExtension

	-
		class: Psl\PHPStan\Type\AssertTypeSpecifyingExtension
		tags:
			- phpstan.typeSpecifier.methodTypeSpecifyingExtension

	-
		class: Psl\PHPStan\Type\MatchesTypeSpecifyingExtension
		tags:
			- phpstan.typeSpecifier.methodTypeSpecifyingExtension

	-
		class: Psl\PHPStan\Option\OptionFilterReturnTypeExtension
		tags:
			- phpstan.broker.dynamicMethodReturnTypeExtension
